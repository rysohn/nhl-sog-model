grid_master <- master2 %>% distinct(longitude, latitude) %>% drop_na()
grid_sal    <- salinity_master %>% distinct(longitude, latitude) %>% drop_na()
sf_master <- st_as_sf(grid_master, coords = c("longitude", "latitude"), crs = 4326)
sf_sal    <- st_as_sf(grid_sal, coords = c("longitude", "latitude"), crs = 4326)
nearest_indices <- st_nearest_feature(sf_master, sf_sal)
crosswalk <- grid_master %>%
mutate(
sal_lon = grid_sal$longitude[nearest_indices],
sal_lat = grid_sal$latitude[nearest_indices]
)
master2 <- master2 %>%
left_join(crosswalk, by = c("longitude", "latitude")) %>%
left_join(salinity_master,
by = c("date" = "date",
"sal_lon" = "longitude",
"sal_lat" = "latitude")) %>%
select(-sal_lon, -sal_lat)
master2
sum(is.na(master2$so))
range(master2$so)
write_parquet(master2, master2.parquet)
write_parquet(master2, 'master2.parquet')
mod_spatial2 <- lmer(
formula = log(chlor_a) ~ poly(sst, 2, raw=T) * as.factor(month(date)) + sla * oni_lag8 + so + (1 | pixel_id),
data = master2,
control = lmerControl(optimizer = 'bobyqa')
)
summary(mod_spatial2)
r.squaredGLMM(mod_spatial2)
range(master2$so)
colnames(master2)
master2 <- master2 %>%
mutate(
so_scaled = as.numeric(scale(so))
)
master2
mod_spatial2 <- lmer(
formula = log(chlor_a) ~ poly(sst_scaled, 2, raw=T) * as.factor(month(date)) + sla_scaled * oni_lag8 + so_scaled + ugosa * vgosa + (1 | pixel_id),
data = master2,
control = lmerControl(optimizer = 'bobyqa')
)
summary(mod_spatial2)
r.squaredGLMM(mod_spatial2)
colnames(master2)
master2
master2 <- master2 %>%
mutate(
eke_scaled = as.numeric(scale(eke))
)
write_parquet(master2, 'master2.parquet')
mod_spatial2 <- lmer(
formula = log(chlor_a) ~ poly(sst_scaled, 2, raw=T) * as.factor(month(date)) + sla_scaled * oni_lag8 + so_scaled + eke_scaled + (1 | pixel_id),
data = master2,
control = lmerControl(optimizer = 'bobyqa')
)
